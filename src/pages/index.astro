---
import fs from "node:fs";
import Layout from "../layouts/Layout.astro";

const languages = fs
  .readdirSync("src/content")
  .filter((f: string) => f.endsWith(".md") && f !== "meta.md")
  .map((f: string) => f.replace(".md", ""));
---

<Layout title="Polyglot — Compare languages">
  <main class="home" data-langs={JSON.stringify(languages)} id="app">
    <h1 class="sentence">
      I know <span class="slot" id="slot-0" data-index="0"></span>, I want to<br />
      learn <span class="slot" id="slot-1" data-index="1"></span>
    </h1>

    <p class="helper">Drag a language into each blank, or click one.</p>

    <div class="pool" id="pool" aria-label="Available languages"></div>

    <a id="go" class="go" aria-disabled="true">Let's go</a>
  </main>

  <script is:inline>
    (() => {
      const app = document.getElementById("app");
      const languages = JSON.parse(app.dataset.langs || "[]");
      const pool = document.getElementById("pool");
      const go = document.getElementById("go");
      const slots = [null, null];
      let dragLang = null;

      const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);

      function chip(lang, cls) {
        return `<button type="button" class="${cls}" draggable="true" data-lang="${lang}">${cap(lang)}</button>`;
      }

      function render() {
        const placed = slots.filter(Boolean);
        pool.innerHTML = languages
          .filter((lang) => !placed.includes(lang))
          .map((lang) => chip(lang, "lang-chip"))
          .join("");

        slots.forEach((lang, i) => {
          const slot = document.getElementById("slot-" + i);
          slot.dataset.lang = lang || "";
          slot.innerHTML = lang
            ? `<span class="slot-text" draggable="true" data-lang="${lang}">${cap(lang)}</span>`
            : "";
        });

        const ready = slots[0] && slots[1];
        if (ready) {
          go.href = "/" + slots[0] + "/vs/" + slots[1];
          go.removeAttribute("aria-disabled");
          go.classList.add("ready");
        } else {
          go.removeAttribute("href");
          go.setAttribute("aria-disabled", "true");
          go.classList.remove("ready");
        }
      }

      function place(lang, index) {
        if (slots[index] === lang) return;
        if (slots[1 - index] === lang) slots[1 - index] = slots[index];
        slots[index] = lang;
        render();
      }

      app.addEventListener("dragstart", (e) => {
        const el = e.target.closest('[draggable="true"][data-lang]');
        if (!el) return;
        dragLang = el.dataset.lang;
        e.dataTransfer.setData("text/plain", el.dataset.lang);
        e.dataTransfer.effectAllowed = "move";
      });

      app.addEventListener("dragover", (e) => {
        if (e.target.closest(".slot")) e.preventDefault();
      });

      app.addEventListener("drop", (e) => {
        const slot = e.target.closest(".slot");
        if (!slot) return;
        e.preventDefault();
        const lang = e.dataTransfer.getData("text/plain") || dragLang;
        if (!lang) return;
        place(lang, Number(slot.dataset.index));
      });

      app.addEventListener("click", (e) => {
        const el = e.target.closest("[data-lang]");
        if (!el) return;
        const lang = el.dataset.lang;
        if (el.classList.contains("lang-chip")) {
          const i = slots.findIndex((s) => !s);
          if (i >= 0) place(lang, i);
        } else if (el.classList.contains("slot-text")) {
          slots[Number(el.closest(".slot").dataset.index)] = null;
          render();
        }
      });

      go.addEventListener("click", (e) => {
        if (!(slots[0] && slots[1])) e.preventDefault();
      });

      render();
    })();
  </script>
</Layout>
