---
import fs from "node:fs";
import Layout from "../../../../layouts/Layout.astro";
import {
  parseSections,
  renderMD,
  validateLanguage,
  renderComparison,
  type Block,
} from "../../../../lib/compare";

function slugify(s: string) {
  return s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

export function getStaticPaths() {
  const contentDir = "src/content";
  const langs = fs
    .readdirSync(contentDir)
    .filter((f: string) => f.endsWith(".md") && f !== "meta.md")
    .map((f: string) => f.replace(".md", ""));

  const paths: { params: { lang1: string; lang2: string } }[] = [];
  for (const l1 of langs) {
    for (const l2 of langs) {
      if (l1 === l2) continue;
      paths.push({ params: { lang1: l1, lang2: l2 } });
    }
  }
  return paths;
}

const { lang1, lang2 } = Astro.params;
const disp = (s: string) => {
  if (s === "cpp") return "C++";
  if (s === "typescript") return "TypeScript";
  return s;
};

const contentDir = "src/content";

const metaTree = parseSections(fs.readFileSync(`${contentDir}/meta.md`, "utf-8"));
const tree1 = parseSections(fs.readFileSync(`${contentDir}/${lang1}.md`, "utf-8"));
const tree2 = parseSections(fs.readFileSync(`${contentDir}/${lang2}.md`, "utf-8"));

validateLanguage(tree1, metaTree, lang1);
validateLanguage(tree2, metaTree, lang2);

const blocks = renderComparison(metaTree, tree1, tree2);

const highlight1 = tree1.children.find((c) => c.level === 1)?.content ?? "";
const highlight2 = tree2.children.find((c) => c.level === 1)?.content ?? "";

const topics: { heading: string; blocks: Block[] }[] = [];
for (const block of blocks) {
  if (block.type === "h2") {
    topics.push({ heading: block.heading ?? "", blocks: [] });
  } else {
    topics[topics.length - 1].blocks.push(block);
  }
}

const toc = topics.map((t) => ({
  heading: t.heading,
  subs: t.blocks.filter((b) => b.type === "h3").map((b) => b.heading ?? ""),
}));
---

<Layout title={`${disp(lang1)} vs ${disp(lang2)} — Polyglot`}>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css"
    />
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/python.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/kotlin.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/rust.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/lua.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/java.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/cpp.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/typescript.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/ruby.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/swift.min.js"
    ></script>
  </Fragment>

  <div class="toc-wrap">
    <div class="toc-inner">
      <div class="toc-trigger">
        <button class="menu-toggle" aria-label="Table of contents"></button>
        <nav class="toc-dropdown" aria-label="On this page">
          {toc.map((t) => (
            <Fragment>
              <a href={`#${slugify(t.heading)}`}>{t.heading}</a>
              {t.subs.map((s) => (
                <a class="toc-sub" href={`#${slugify(s)}`}>{s}</a>
              ))}
            </Fragment>
          ))}
        </nav>
      </div>
    </div>
  </div>

  <main class="content">
    <a href="/" class="back-link">&larr; Back</a>
    <h1 class="page-title">
      <span class="lang">{disp(lang1)}</span>
      <span class="vs">vs</span>
      <span class="lang">{disp(lang2)}</span>
    </h1>
    <div class="lang-highlights">
      <div set:html={renderMD(highlight1)} />
      <div set:html={renderMD(highlight2)} />
    </div>
    {
      topics.map((topic) => (
        <details id={slugify(topic.heading)} class="topic" open>
          <summary>
            <h2>{topic.heading}</h2>
          </summary>
          <div class="topic-body">
            {topic.blocks.map((block) => {
              if (block.type === "h3") {
                return (
                  <h3 id={slugify(block.heading ?? "")}>{block.heading}</h3>
                );
              }
              if (block.type === "h4") {
                return (
                  <h4 id={slugify(block.heading ?? "")}>{block.heading}</h4>
                );
              }
              if (block.type === "intro") {
                return (
                  <div class="topic-intro">
                    {block.intro!.meta.trim() && (
                      <div set:html={renderMD(block.intro!.meta)} />
                    )}
                    {block.intro!.lang1.trim() && (
                      <div set:html={renderMD(block.intro!.lang1)} />
                    )}
                    {block.intro!.lang2.trim() && (
                      <div set:html={renderMD(block.intro!.lang2)} />
                    )}
                  </div>
                );
              }
              if (block.type === "group-intro") {
                return (
                  <div class="group-prose">
                    {block.prose!.content1.trim() && (
                      <div set:html={renderMD(block.prose!.content1)} />
                    )}
                    {block.prose!.content2.trim() && (
                      <div set:html={renderMD(block.prose!.content2)} />
                    )}
                  </div>
                );
              }
              return (
                <table>
                  <thead>
                    <tr>
                      <th />
                      <th>{disp(lang1)}</th>
                      <th>{disp(lang2)}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {block.items!.map((item) => (
                      <tr>
                        <td class="col-label">{item.label}</td>
                        <td
                          set:html={
                            item.content1.trim() ? renderMD(item.content1) : ""
                          }
                        />
                        <td
                          set:html={
                            item.content2.trim() ? renderMD(item.content2) : ""
                          }
                        />
                      </tr>
                    ))}
                  </tbody>
                </table>
              );
            })}
          </div>
        </details>
      ))
    }
  </main>

  <aside class="side-toc" aria-label="On this page">
    <ul>
      {toc.map((t) => (
        <Fragment>
          <li class="l2">
            <a href={`#${slugify(t.heading)}`}>{t.heading}</a>
          </li>
          {t.subs.map((s) => (
            <li class="l3">
              <a href={`#${slugify(s)}`}>{s}</a>
            </li>
          ))}
        </Fragment>
      ))}
    </ul>
  </aside>

  <script is:inline>
    hljs.highlightAll();

    const tocLinks = document.querySelectorAll(".side-toc a, .toc-dropdown a");
    const sections = Array.from(tocLinks)
      .map((l) => document.querySelector(l.getAttribute("href")))
      .filter(Boolean);
    let currentId = null;
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) currentId = e.target.id;
        });
        tocLinks.forEach((l) =>
          l.classList.toggle("active", l.getAttribute("href") === "#" + currentId)
        );
      },
      { rootMargin: "0px 0px -75% 0px", threshold: 0 }
    );
    sections.forEach((s) => spy.observe(s));
  </script>
</Layout>
