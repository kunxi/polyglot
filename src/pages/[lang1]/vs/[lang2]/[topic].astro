---
import fs from 'node:fs';
import { parseSections, renderMD, buildLookup, flatten } from '../../../../lib/compare';

export function getStaticPaths() {
  const contentDir = 'src/content';
  const langDirs = fs.readdirSync(contentDir, { withFileTypes: true })
    .filter((d: fs.Dirent) => d.isDirectory())
    .map((d: fs.Dirent) => d.name);
  const paths: { params: { lang1: string; lang2: string; topic: string } }[] = [];
  for (const l1 of langDirs) {
    const l1Topics = fs.readdirSync(`${contentDir}/${l1}`)
      .filter((f: string) => f.endsWith('.md'))
      .map((f: string) => f.replace('.md', ''));
    for (const l2 of langDirs) {
      if (l1 === l2) continue;
      const l2Topics = fs.readdirSync(`${contentDir}/${l2}`)
        .filter((f: string) => f.endsWith('.md'))
        .map((f: string) => f.replace('.md', ''));
      for (const topic of l1Topics) {
        if (l2Topics.includes(topic)) {
          paths.push({ params: { lang1: l1, lang2: l2, topic } });
        }
      }
    }
  }
  return paths;
}

const { lang1, lang2, topic } = Astro.params;

// ponytail: import.meta.glob registers content files as Vite dependencies for rebuilds
const _contentModules = import.meta.glob('/src/content/*/*.md', { eager: true, query: '?raw' });

const raw1 = (_contentModules[`/src/content/${lang1}/${topic}.md`] as any)?.default ?? '';
const raw2 = (_contentModules[`/src/content/${lang2}/${topic}.md`] as any)?.default ?? '';
const tree1 = parseSections(raw1);
const tree2 = parseSections(raw2);
const lookup2 = buildLookup(tree2);
const blocks = flatten(tree1, lookup2);
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{lang1} vs {lang2}: {topic} — Polyglot</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github.min.css" />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/python.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/kotlin.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/rust.min.js"></script>
  <link rel="stylesheet" href="/index.css" />
</head>
<body>
  <h1>{lang1} vs {lang2}: {topic}</h1>
  <p class="subtitle">Side-by-side language comparison</p>

  {blocks.map((block) => {
    if (block.type === 'h2') {
      return <h2>{block.heading}</h2>;
    }
    if (block.type === 'h3') {
      return <h3>{block.heading}</h3>;
    }
    // table
    return (
      <table>
        <thead>
          <tr><th></th><th>{lang1}</th><th>{lang2}</th></tr>
        </thead>
        <tbody>
          {block.items!.map((item) => (
            <tr>
              <td class="col-label">{item.label}</td>
              <td set:html={item.content1.trim() ? renderMD(item.content1) : ''} />
              <td set:html={item.content2.trim() ? renderMD(item.content2) : ''} />
            </tr>
          ))}
        </tbody>
      </table>
    );
  })}
</body>
<script is:inline>hljs.highlightAll();</script>
</html>