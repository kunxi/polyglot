---
import fs from 'node:fs';
import { parseSections, renderMD, buildLookup, flatten } from '../../../lib/compare';

export function getStaticPaths() {
  const contentDir = 'src/content';
  const files = fs.readdirSync(contentDir).filter((f: string) => f.endsWith('.md'));
  const langs = files.map((f: string) => f.replace('.md', ''));
  const paths: { params: { lang1: string; lang2: string } }[] = [];
  for (const l1 of langs) {
    for (const l2 of langs) {
      if (l1 !== l2) paths.push({ params: { lang1: l1, lang2: l2 } });
    }
  }
  return paths;
}

const { lang1, lang2 } = Astro.params;

// ponytail: import.meta.glob registers content files as Vite dependencies for rebuilds
const _contentModules = import.meta.glob('/src/content/*.md', { eager: true, query: '?raw' });

const raw1 = (_contentModules[`/src/content/${lang1}.md`] as any)?.default ?? '';
const raw2 = (_contentModules[`/src/content/${lang2}.md`] as any)?.default ?? '';
const tree1 = parseSections(raw1);
const tree2 = parseSections(raw2);
const lookup2 = buildLookup(tree2);
const blocks = flatten(tree1, lookup2);
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{lang1} vs {lang2} — Polyglot</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github.min.css" />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/python.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/kotlin.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/rust.min.js"></script>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      max-width: 1020px;
      margin: 0 auto;
      padding: 2rem 1rem;
      color: #1a1a1a;
      line-height: 1.6;
    }
    h1 { font-size: 1.75rem; margin-bottom: 0.25rem; }
    .subtitle { color: #666; margin-bottom: 2rem; }
    h2 { font-size: 1.3rem; margin: 2.5rem 0 1rem; padding-bottom: 0.25rem; border-bottom: 2px solid #e5e5e5; }
    h3 { font-size: 1.1rem; margin: 2rem 0 0.75rem; }
    table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }
    th, td {
      padding: 0.5rem 0.75rem;
      border: 1px solid #e0e0e0;
      vertical-align: top;
    }
    th {
      background: #f5f5f5;
      font-weight: 600;
      text-align: left;
      font-size: 0.8rem;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    th:first-child { width: 16%; }
    .col-label {
      font-weight: 500;
      white-space: nowrap;
      font-size: 0.85rem;
      color: #444;
    }
    .col-label:empty {
      background: #fafafa;
    }
    td pre {
      margin: 0;
      font-size: 0.8rem;
      padding: 0.4rem 0.5rem;
      border-radius: 3px;
      overflow-x: auto;
      max-width: 100%;
    }
    td code {
      font-size: 0.84rem;
      background: #f0f0f0;
      padding: 0.1em 0.3em;
      border-radius: 2px;
    }
    td p { margin: 0.25rem 0; }
    td p:first-child { margin-top: 0; }
    td p:last-child { margin-bottom: 0; }
    .hljs { padding: 0; }
  </style>
</head>
<body>
  <h1>{lang1} vs {lang2}</h1>
  <p class="subtitle">Side-by-side language comparison</p>

  {blocks.map((block) => {
    if (block.type === 'h2') {
      return <h2>{block.heading}</h2>;
    }
    if (block.type === 'h3') {
      return <h3>{block.heading}</h3>;
    }
    // table
    return (
      <table>
        <thead>
          <tr><th></th><th>{lang1}</th><th>{lang2}</th></tr>
        </thead>
        <tbody>
          {block.items!.map((item) => (
            <tr>
              <td class="col-label">{item.label}</td>
              <td set:html={item.content1.trim() ? renderMD(item.content1) : ''} />
              <td set:html={item.content2.trim() ? renderMD(item.content2) : ''} />
            </tr>
          ))}
        </tbody>
      </table>
    );
  })}
</body>
<script is:inline>hljs.highlightAll();</script>
</html>